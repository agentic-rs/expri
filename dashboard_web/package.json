{
  "name": "expri-dashboard-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "tsc --noEmit && esbuild app.tsx --bundle --format=esm --target=es2022 --jsx=automatic --define:process.env.NODE_ENV='\"production\"' --minify --legal-comments=eof --outfile=app.js",
    "build:test": "esbuild app.tsx --bundle --format=esm --target=es2022 --jsx=automatic --packages=external --legal-comments=none --outfile=.test/app.js",
    "check": "tsc --noEmit",
    "test": "pnpm build:test && node --test *.test.mjs"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
